<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Button text="Create New State" name="CreateNewStateToggle" enabled="true" />
    <ui:VisualElement name="CreateNewStateElement" style="flex-grow: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 5px; background-color: rgba(0, 0, 0, 0.5); display: flex; padding-top: 5px; padding-bottom: 5px;">
        <ui:DropdownField label="Stateset" name="StatesetDropdown" style="margin-bottom: 5px;" />
        <ui:DropdownField label="State Group&#10;" name="StateGroupDropdown" style="margin-bottom: 5px;" />
        <ui:TextField label="State Name" value="New State" name="StateName" style="margin-bottom: 5px;" />
        <ui:Button text="Create" name="Create" />
    </ui:VisualElement>
</ui:UXML>
