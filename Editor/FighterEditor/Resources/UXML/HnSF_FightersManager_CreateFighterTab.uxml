<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:Label text="CREATE FIGHTER" style="-unity-text-align: upper-center; font-size: 25px; -unity-font-style: bold;" />
    <ui:DropdownField label="Mod" name="ModDropdown" />
    <ui:TextField label="Name" name="NameField" style="margin-left: 20px; margin-right: 20px; min-width: 300px;" />
    <ui:Label text="Description" style="margin-left: 20px; margin-right: 20px; margin-bottom: 5px;" />
    <ui:TextField name="DescriptionField" style="margin-left: 20px; margin-right: 20px; min-width: 300px; min-height: 75px;" />
    <ui:DropdownField label="Template" name="TemplateDropdown" />
    <ui:VisualElement name="DestinationPath" style="flex-grow: 0; flex-direction: row;">
        <ui:TextField label="Destination Path" value="Fighters" readonly="true" style="flex-grow: 1;" />
        <ui:Button text="..." />
    </ui:VisualElement>
    <ui:Button text="Create" name="CreateButton" />
</ui:UXML>
